# Public Supabase project values, available in the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred current Supabase browser key (starts with sb_publishable_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback; use only if your project has an anon key instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Use a service role only for administrative background tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Gemini key used for embeddings and chat. Create one free at
# https://aistudio.google.com/apikey (no billing required).
GEMINI_API_KEY=

# Optional model overrides.
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Canonical deployed URL used for social metadata, e.g. https://studyos.vercel.app
NEXT_PUBLIC_APP_URL=
